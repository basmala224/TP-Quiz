<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layout_racine"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fond"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <!-- Bandeau hors du ScrollView : le score reste toujours visible. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txt_titre"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/titre_quiz"
                android:textColor="@color/texte"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txt_score"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:accessibilityLiveRegion="polite"
                android:textColor="@color/primaire"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="Score : 0/5" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progress_quiz"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:max="5"
            tools:progress="2" />

        <TextView
            android:id="@+id/txt_progression"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/texte_secondaire"
            android:textSize="14sp"
            tools:text="Réponses données : 2 sur 5" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/scroll_contenu"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <!-- Zone du quiz -->
            <LinearLayout
                android:id="@+id/zone_question"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txt_numero_question"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/texte_secondaire"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="Question 2 sur 5" />

                <!-- fitCenter conserve les proportions : pas de déformation. -->
                <ImageView
                    android:id="@+id/img_question"
                    android:layout_width="match_parent"
                    android:layout_height="170dp"
                    android:layout_marginTop="8dp"
                    android:scaleType="fitCenter"
                    tools:ignore="ContentDescription"
                    tools:src="@drawable/triangle" />

                <TextView
                    android:id="@+id/txt_question"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/texte"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    tools:text="Combien de côtés possède cette forme ?" />

                <Button
                    android:id="@+id/btn_choix1"
                    style="@style/Widget.QuizImages.BoutonChoix"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    tools:text="Choix 1" />

                <Button
                    android:id="@+id/btn_choix2"
                    style="@style/Widget.QuizImages.BoutonChoix"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    tools:text="Choix 2" />

                <Button
                    android:id="@+id/btn_choix3"
                    style="@style/Widget.QuizImages.BoutonChoix"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    tools:text="Choix 3" />

                <TextView
                    android:id="@+id/txt_correction"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:accessibilityLiveRegion="polite"
                    android:padding="12dp"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:text="✓ Bonne réponse ! Vous gagnez 1 point."
                    tools:visibility="visible" />

                <Button
                    android:id="@+id/btn_suivant"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/question_suivante"
                    android:visibility="gone"
                    tools:visibility="visible" />
            </LinearLayout>

            <!-- Zone du résultat final, dans la même activité -->
            <LinearLayout
                android:id="@+id/zone_resultat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/txt_resultat_titre"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/resultat_titre"
                    android:textColor="@color/texte"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txt_resultat_score"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:textColor="@color/primaire"
                    android:textSize="30sp"
                    android:textStyle="bold"
                    tools:text="Score final : 3/5" />

                <TextView
                    android:id="@+id/txt_resultat_message"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:textColor="@color/texte_secondaire"
                    android:textSize="16sp"
                    tools:text="Bien joué, encore un petit effort pour le score parfait." />

                <Button
                    android:id="@+id/btn_rejouer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@string/rejouer" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
